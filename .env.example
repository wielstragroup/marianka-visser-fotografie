# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the client. Used for admin
# provisioning and any privileged server-side operation.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email for the contact form notification)
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=info@mariankavisserfotografie.nl
# Requires a verified sending domain in Resend; falls back to a shared
# sandbox sender until then.
RESEND_FROM_EMAIL="Marianka Visser Fotografie <info@mariankavisserfotografie.nl>"

# Public site URL, used for metadata, sitemap and canonical URLs
NEXT_PUBLIC_SITE_URL=https://mariankavisserfotografie.nl
